# 서버 전용. 실제 키를 public/ 또는 저장소에 넣지 마세요.
DECART_API_KEY=
ANTHROPIC_API_KEY=
HAIR_VISION_MODEL=claude-sonnet-5-5
HAIR_DESCRIBE_DAILY_IP_LIMIT=20
HAIR_DESCRIBE_DAILY_TOTAL_LIMIT=500
# 헤어 미리보기 이미지 편집 (기본: Gemini)
HAIR_EDIT_PROVIDER=gemini
HAIR_EDIT_MODEL=gemini-3-pro-image
# /lab?editmodel= 로 덮어쓸 수 있는 모델 ID (쉼표 구분). 기본은 Gemini 3 Pro Image.
# https://ai.google.dev/gemini-api/docs/image-generation
# https://ai.google.dev/gemini-api/docs/pricing
HAIR_EDIT_MODEL_ALLOWLIST=gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-3-pro-image,gemini-2.5-flash-image
GEMINI_API_KEY=
HAIR_PREVIEW_DAILY_IP_LIMIT=10
HAIR_PREVIEW_DAILY_TOTAL_LIMIT=200
# 모수 마스크 인페인팅 (정지 이미지). 키는 GEMINI_API_KEY 재사용.
GRAFT_INPAINT_MODEL=gemini-3-pro-image
GRAFT_INPAINT_DAILY_IP_LIMIT=20
GRAFT_INPAINT_DAILY_TOTAL_LIMIT=400
# Lucy set() enhance 기본값. /lab?enhance=true|false 로 덮어쓰기 가능.
GRAFT_ENHANCE=false
PRIVACY_EDIT_SERVICE=Google Gemini
PRIVACY_EDIT_REGION=국외(미국 등)
PORT=3000
APP_ORIGIN=http://localhost:3000
# 실제 프록시를 사용하는 경우에만 신뢰할 hop 수를 지정합니다.
TRUST_PROXY=0
TOKEN_DAILY_IP_LIMIT=3
TOKEN_DAILY_TOTAL_LIMIT=100
# STEP 07 검증 후 고정할 기본값. /lab에서만 URL 조건 변경 가능.
SIMULATOR_MODE=ref
SIMULATOR_ANCHOR=on
ENABLE_LAB=true
# 비공개 이미지 저장(Drive): 서비스 계정 키 JSON 파일 경로(GOOGLE_APPLICATION_CREDENTIALS).
# 일반 내 드라이브가 아닌 비공개 공유 드라이브 폴더 ID.
GOOGLE_DRIVE_FOLDER_ID=
# 개인정보 안내: 운영 전 실제 운영자/목적/보관 기간을 설정하세요.
PRIVACY_OPERATOR=모수 시뮬레이터 운영자
PRIVACY_RETENTION=수집일로부터 30일
REFERRAL_RECIPIENT=소개를 요청한 지역의 제휴 병원
